<%- include('../partials/public-header', { title: 'Orçamento da OS | AssistTech' }) %>

    <% const equipamentoOrcamento=[manutencao.marcaComputador, manutencao.modeloComputador].filter(Boolean).join(' '); %>

    <div class="container public-quote-page">
        <main class="public-quote">
            <header class="public-quote-header">
                <div>
                    <div class="page-eyebrow">AssistTech · Ordem de serviço</div>
                    <h1 class="page-title">Orçamento <%= manutencao.numeroOrdem || '' %>
                    </h1>
                    <p class="page-subtitle">Revise os itens e valores antes de informar sua decisão.</p>
                </div>
                <span
                    class="status-badge <%= manutencao.status === ' aguardando_aprovacao' ? 'status-analysis' :
        manutencao.status==='orcamento_aprovado' ? 'status-done' : manutencao.status==='orcamento_recusado'
        ? 'status-rejected' : 'bg-secondary text-white' %>">
        <%= manutencao.status==='aguardando_aprovacao' ? 'Aguardando sua decisão' :
            manutencao.status==='orcamento_aprovado' ? 'Orçamento aprovado' : manutencao.status==='orcamento_recusado'
            ? 'Orçamento recusado' : manutencao.status %>
            </span>
            </header>

            <section class="public-quote-section">
                <h2>Atendimento</h2>
                <dl class="public-quote-meta">
                    <div>
                        <dt>Cliente</dt>
                        <dd>
                            <%= manutencao.cliente?.nome || 'Cliente' %>
                        </dd>
                    </div>
                    <div>
                        <dt>Equipamento</dt>
                        <dd>
                            <%= equipamentoOrcamento || '-' %>
                        </dd>
                    </div>
                    <div>
                        <dt>Problema informado</dt>
                        <dd>
                            <%= manutencao.descricaoProblema || '-' %>
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="public-quote-section">
                <h2>Itens do orçamento</h2>
                <% if (manutencao.itensOrcamento && manutencao.itensOrcamento.length) { %>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Descrição</th>
                                    <th>Qtd.</th>
                                    <th>Valor unitário</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% manutencao.itensOrcamento.forEach(function(item) { %>
                                    <tr>
                                        <td>
                                            <%= item.descricao || item.componente?.nome || 'Peça' %>
                                        </td>
                                        <td>
                                            <%= item.quantidade %>
                                        </td>
                                        <td>R$ <%= Number(item.valorUnitario || 0).toLocaleString('pt-BR', {
                                                minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </td>
                                        <td class="text-end">R$ <%= (Number(item.quantidade || 0) *
                                                Number(item.valorUnitario || 0)).toLocaleString('pt-BR', {
                                                minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                        <p class="text-secondary mb-0">Sem peças neste orçamento.</p>
                        <% } %>
                            <div class="public-quote-totals">
                                <div><span>Mão de obra</span><strong>R$ <%= Number(manutencao.valorMaoDeObra ||
                                            0).toLocaleString('pt-BR', { minimumFractionDigits: 2,
                                            maximumFractionDigits: 2 }) %></strong></div>
                                <div class="public-quote-grand-total"><span>Total</span><strong>R$ <%=
                                            Number(manutencao.valorTotal || 0).toLocaleString('pt-BR', {
                                            minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></div>
                            </div>
            </section>

            <% if (manutencao.status==='aguardando_aprovacao' && manutencao.tokenAprovacaoExpiraEm) { %>
                <p class="quote-link-expiry">Link válido até <%= new
                        Date(manutencao.tokenAprovacaoExpiraEm).toLocaleString('pt-BR') %>.</p>
                <% } %>

                    <% if (expirado && manutencao.status==='aguardando_aprovacao' ) { %>
                        <div class="alert alert-warning mb-0">Este link expirou. Entre em contato com a assistência
                            técnica para solicitar um novo.</div>
                        <% } else if (manutencao.status==='aguardando_aprovacao' ) { %>
                            <section class="public-quote-decision">
                                <p>Ao aprovar, você autoriza a assistência a iniciar o reparo pelo valor total
                                    informado. A aprovação não realiza cobrança automática.</p>
                                <div class="d-flex flex-wrap gap-2">
                                    <form method="post" action="/orcamentos/<%= encodeURIComponent(token) %>/decisao">
                                        <input type="hidden" name="decisao" value="aprovar">
                                        <button type="submit" class="btn btn-primary">Aprovar orçamento</button>
                                    </form>
                                    <form method="post" action="/orcamentos/<%= encodeURIComponent(token) %>/decisao">
                                        <input type="hidden" name="decisao" value="recusar">
                                        <button type="submit" class="btn btn-outline-secondary">Recusar
                                            orçamento</button>
                                    </form>
                                </div>
                            </section>
                            <% } else if (manutencao.status==='orcamento_aprovado' ) { %>
                                <div class="alert alert-success mb-0">Sua aprovação foi registrada. A assistência
                                    técnica dará continuidade ao atendimento.</div>
                                <% } else if (manutencao.status==='orcamento_recusado' ) { %>
                                    <div class="alert alert-info mb-0">Sua recusa foi registrada. Nenhum reparo será
                                        iniciado com base neste orçamento.</div>
                                    <% } else { %>
                                        <div class="alert alert-secondary mb-0">Este orçamento não está mais disponível
                                            para decisão.</div>
                                        <% } %>
                                            </main>
                                            </div>

                                            <%- include('../partials/public-footer') %>