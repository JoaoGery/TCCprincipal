<%- include('../partials/header', { title: 'Detalhes da manutenção | AssistTech' }) %>

  <div class="container">
    <%- include('../partials/flash') %>
      <% const statusMap={ em_analise: ['status-analysis', 'Em análise' ], aguardando_aprovacao:
        ['status-analysis', 'Aguardando aprovação' ], orcamento_aprovado: ['status-done', 'Orçamento aprovado' ],
        orcamento_recusado: ['status-rejected', 'Orçamento recusado' ], em_reparo: ['status-repair', 'Em reparo' ],
        concluido: ['status-done', 'Concluído' ] }; %>
        <% const statusInfo=statusMap[manutencao.status] || ['bg-secondary text-white', 'Sem status' ]; %>
          <% const componentesExibidos=(manutencao.itensOrcamento && manutencao.itensOrcamento.length) ?
            manutencao.itensOrcamento : ((manutencao.componentesUsados && manutencao.componentesUsados.length) ?
            manutencao.componentesUsados : (manutencao.componentes || []).map(function(componente) { return {
            componente: componente, quantidade: 1 }; })); %>

            <div class="d-flex flex-column flex-md-row justify-content-between gap-3 page-heading">
              <div>
                <div class="page-eyebrow">Ordem de serviço</div>
                <h1 class="page-title">
                  <%= manutencao.numeroOrdem || 'Detalhes da manutenção' %>
                </h1>
                <p class="page-subtitle">
                  <%= manutencao.marcaComputador || '-' %>
                    <%= manutencao.modeloComputador || '' %> para <%= manutencao.cliente?.nome || 'cliente removido' %>.
                </p>
              </div>
              <div class="d-flex gap-2 align-items-start page-actions">
                <a href="/manutencoes" class="btn btn-outline-secondary">Voltar</a>
                <button type="button" class="btn btn-outline-primary" data-print-os="company">Imprimir cópia da
                  empresa</button>
                <button type="button" class="btn btn-outline-secondary" data-print-os="customer">Imprimir cópia do
                  cliente</button>
                <a href="/manutencoes/<%= manutencao._id %>/editar" class="btn btn-primary">Editar</a>
              </div>
            </div>

            <div class="row g-3">
              <div class="col-lg-8">
                <section class="content-card form-card mb-3">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <div class="info-label">Cliente</div>
                      <div class="info-value">
                        <%= manutencao.cliente?.nome || 'Não informado' %>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="info-label">Status</div>
                      <div class="info-value"><span class="status-badge <%= statusInfo[0] %>">
                          <%= statusInfo[1] %>
                        </span></div>
                    </div>
                    <div class="col-md-6">
                      <div class="info-label">Entrada</div>
                      <div class="info-value">
                        <%= manutencao.dataEntrada ? new Date(manutencao.dataEntrada).toLocaleDateString('pt-BR') : '-'
                          %>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="info-label">Saída</div>
                      <div class="info-value">
                        <%= manutencao.dataSaida ? new Date(manutencao.dataSaida).toLocaleDateString('pt-BR') : '-' %>
                      </div>
                    </div>
                  </div>
                </section>

                <section class="content-card form-card mb-3">
                  <h2 class="h5 mb-3">Problema relatado</h2>
                  <p class="mb-0">
                    <%= manutencao.descricaoProblema || 'Nenhuma descrição informada.' %>
                  </p>
                </section>

                <section class="content-card form-card mb-3">
                  <h2 class="h5 mb-3">Diagnóstico técnico</h2>
                  <p class="mb-0">
                    <%= manutencao.diagnosticoTecnico || 'Diagnóstico ainda não informado.' %>
                  </p>
                </section>

                <section class="content-card form-card">
                  <h2 class="h5 mb-3">Observações</h2>
                  <p class="mb-0">
                    <%= manutencao.observacoes || 'Nenhuma observação registrada.' %>
                  </p>
                </section>
              </div>

              <div class="col-lg-4">
                <section class="content-card form-card mb-3">
                  <h2 class="h5 mb-3">Peças do orçamento</h2>
                  <% if (componentesExibidos.length) { %>
                    <ul class="list-group list-group-flush">
                      <% componentesExibidos.forEach(function(uso) { %>
                        <% const componente=uso.componente || {}; %>
                          <li class="list-group-item px-0 d-flex justify-content-between gap-2">
                            <span>
                              <%= Number(uso.quantidade || 1) %>x <%= uso.descricao || componente.nome
                                  || 'Componente removido' %>
                            </span>
                            <span class="text-secondary">
                              R$ <%= (Number(uso.quantidade || 1) * Number(uso.valorUnitario ||
                                0)).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                            </span>
                          </li>
                          <% }) %>
                    </ul>
                    <% } else { %>
                      <p class="text-secondary mb-0">Nenhum componente vinculado.</p>
                      <% } %>
                </section>

                <section class="content-card form-card">
                  <div class="info-label">Valor total</div>
                  <div class="metric-value">R$ <%= Number(manutencao.valorTotal || 0).toFixed(2) %>
                  </div>
                  <div class="form-text">Inclui peças e mão de obra: R$ <%= Number(manutencao.valorMaoDeObra ||
                      0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                  </div>
                </section>

                <section class="content-card form-card quote-share-card">
                  <div class="page-eyebrow">Aprovação do cliente</div>
                  <h2 class="h5 mb-2">Orçamento</h2>
                  <% if (manutencao.status==='aguardando_aprovacao' ) { %>
                    <p class="text-secondary">Aguardando o cliente aprovar ou recusar o valor de R$ <%=
                        Number(manutencao.valorTotal || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2,
                        maximumFractionDigits: 2 }) %>.</p>
                    <% } else if (manutencao.status==='orcamento_aprovado' ) { %>
                      <p class="text-success">Aprovado pelo cliente<%= manutencao.aprovadoEm ? ' em ' + new
                          Date(manutencao.aprovadoEm).toLocaleString('pt-BR') : '' %>. O estoque será baixado ao iniciar
                          o reparo.</p>
                      <% } else if (manutencao.status==='orcamento_recusado' ) { %>
                        <p class="text-secondary">O cliente recusou este orçamento<%= manutencao.recusadoEm ? ' em ' +
                            new Date(manutencao.recusadoEm).toLocaleString('pt-BR') : '' %>.</p>
                        <% } else if (['em_reparo', 'concluido' ].includes(manutencao.status)) { %>
                          <p class="text-secondary">O reparo já foi iniciado; o orçamento não pode ser reenviado.</p>
                          <% } else { %>
                            <p class="text-secondary">Gere um link para o cliente consultar os valores e registrar sua
                              decisão.</p>
                            <% } %>

                              <% if (!['em_reparo', 'concluido' ].includes(manutencao.status)) { %>
                                <form method="post" action="/manutencoes/<%= manutencao._id %>/orcamento/link">
                                  <button type="submit" class="btn btn-primary">
                                    <%= approvalUrl ? 'Gerar novo link' : 'Gerar link de aprovação' %>
                                  </button>
                                </form>
                                <small class="form-text">Um novo link invalida qualquer link anterior e expira em 7
                                  dias.</small>
                                <% } %>

                                  <% if (approvalUrl) { %>
                                    <label class="form-label mt-3" for="approvalUrl">Link para enviar ao cliente</label>
                                    <div class="input-group">
                                      <input id="approvalUrl" class="form-control" type="url" value="<%= approvalUrl %>"
                                        readonly>
                                      <button class="btn btn-outline-secondary" type="button"
                                        data-copy-quote-link>Copiar</button>
                                    </div>
                                    <div class="customer-message-actions mt-3">
                                      <% if (quoteWhatsappUrl) { %>
                                        <a class="btn btn-success" href="<%= quoteWhatsappUrl %>" target="_blank"
                                          rel="noopener noreferrer">Enviar pelo WhatsApp</a>
                                        <% } %>
                                          <% if (quoteGmailUrl) { %>
                                            <a class="btn btn-outline-primary" href="<%= quoteGmailUrl %>"
                                              target="_blank" rel="noopener noreferrer">Enviar por e-mail</a>
                                            <% } %>
                                    </div>
                                    <% } %>
                </section>

                <section class="content-card form-card customer-message-card">
                  <div class="page-eyebrow">Comunicação</div>
                  <h2 class="h5 mb-2">Enviar atualização ao cliente</h2>
                  <p class="text-secondary">A mensagem inclui o nome do cliente, o equipamento, a ordem de serviço e o
                    status atual. Revise o texto antes de enviar.</p>
                  <details class="customer-message-preview">
                    <summary>Visualizar mensagem</summary>
                    <p>
                      <%= mensagemCliente %>
                    </p>
                  </details>
                  <div class="customer-message-actions">
                    <% if (whatsappUrl) { %>
                      <a class="btn btn-success" href="<%= whatsappUrl %>" target="_blank"
                        rel="noopener noreferrer">Abrir
                        no WhatsApp</a>
                      <% } else { %>
                        <span class="form-text">Telefone inválido para criar uma mensagem no WhatsApp.</span>
                        <% } %>
                          <% if (gmailUrl) { %>
                            <a class="btn btn-outline-primary" href="<%= gmailUrl %>" target="_blank"
                              rel="noopener noreferrer">Abrir no Gmail</a>
                            <% } else { %>
                              <span class="form-text">Cliente sem e-mail cadastrado.</span>
                              <% } %>
                  </div>
                </section>
              </div>
            </div>
  </div>

  <section class="print-document print-company" aria-hidden="true">
    <header class="print-header">
      <div>
        <h1>AssistTech</h1>
        <p>Via da empresa</p>
      </div>
      <div class="print-os-number">
        <strong>ORDEM DE SERVIÇO</strong>
        <span>
          <%= manutencao.numeroOrdem || '-' %>
        </span>
      </div>
    </header>

    <div class="print-grid">
      <div><span>Cliente</span><strong>
          <%= manutencao.cliente?.nome || 'Não informado' %>
        </strong></div>
      <div><span>CPF / CNPJ</span><strong>
          <%= manutencao.cliente?.documento || '-' %>
        </strong></div>
      <div><span>Telefone</span><strong>
          <%= manutencao.cliente?.telefone || '-' %>
        </strong></div>
      <div><span>E-mail</span><strong>
          <%= manutencao.cliente?.email || '-' %>
        </strong></div>
      <div><span>Endereço</span><strong>
          <%= [manutencao.cliente?.endereco, manutencao.cliente?.cidade, manutencao.cliente?.estado,
            manutencao.cliente?.cep].filter(Boolean).join(', ') || ' -' %>
        </strong></div>
      <div><span>Status</span><strong>
          <%= statusInfo[1] %>
        </strong></div>
    </div>

    <section class="print-section">
      <h2>Equipamento</h2>
      <p><strong>
          <%= manutencao.marcaComputador || '-' %>
            <%= manutencao.modeloComputador || '' %>
        </strong></p>
    </section>

    <section class="print-section">
      <h2>Problema relatado</h2>
      <p>
        <%= manutencao.descricaoProblema || 'Não informado.' %>
      </p>
    </section>

    <section class="print-section">
      <h2>Diagnóstico técnico</h2>
      <p>
        <%= manutencao.diagnosticoTecnico || 'Não informado.' %>
      </p>
    </section>

    <section class="print-section">
      <h2>Observações internas</h2>
      <p>
        <%= manutencao.observacoes || 'Nenhuma observação registrada.' %>
      </p>
    </section>

    <section class="print-section">
      <h2>Peças previstas no orçamento</h2>
      <% if (componentesExibidos.length) { %>
        <table class="print-table">
          <thead>
            <tr>
              <th>Peça</th>
              <th>Qtd.</th>
              <th>Unitário</th>
              <th class="text-end">Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% componentesExibidos.forEach(function(uso) { %>
              <% const componente=uso.componente || {}; %>
                <% const unitario=Number(uso.valorUnitario ?? componente.precoUnitario ?? 0); %>
                  <tr>
                    <td>
                      <%= uso.descricao || componente.nome || '-' %>
                    </td>
                    <td>
                      <%= Number(uso.quantidade || 1) %>
                    </td>
                    <td>R$ <%= unitario.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        %>
                    </td>
                    <td class="text-end">R$ <%= (unitario * Number(uso.quantidade || 1)).toLocaleString('pt-BR', {
                        minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                    </td>
                  </tr>
                  <% }) %>
          </tbody>
        </table>
        <% } else { %>
          <p>Nenhum componente vinculado.</p>
          <% } %>
    </section>

    <div class="print-grid print-grid-bottom">
      <div><span>Entrada</span><strong>
          <%= manutencao.dataEntrada ? new Date(manutencao.dataEntrada).toLocaleDateString('pt-BR') : '-' %>
        </strong></div>
      <div><span>Saída</span><strong>
          <%= manutencao.dataSaida ? new Date(manutencao.dataSaida).toLocaleDateString('pt-BR') : '-' %>
        </strong></div>
      <div><span>Valor total</span><strong>R$ <%= Number(manutencao.valorTotal || 0).toLocaleString('pt-BR', {
            minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></div>
    </div>

    <div class="print-signatures">
      <div><span>Responsável técnico</span></div>
      <div><span>Cliente / responsável</span></div>
    </div>
  </section>

  <section class="print-document print-customer" aria-hidden="true">
    <header class="print-header">
      <div>
        <h1>AssistTech</h1>
        <p>Comprovante para o cliente</p>
      </div>
      <div class="print-os-number">
        <strong>ORDEM DE SERVIÇO</strong>
        <span>
          <%= manutencao.numeroOrdem || '-' %>
        </span>
      </div>
    </header>

    <div class="print-grid">
      <div><span>Cliente</span><strong>
          <%= manutencao.cliente?.nome || 'Não informado' %>
        </strong></div>
      <div><span>Status</span><strong>
          <%= statusInfo[1] %>
        </strong></div>
    </div>

    <section class="print-section">
      <h2>Equipamento</h2>
      <p><strong>
          <%= manutencao.marcaComputador || '-' %>
            <%= manutencao.modeloComputador || '' %>
        </strong></p>
    </section>

    <section class="print-section">
      <h2>Problema informado</h2>
      <p>
        <%= manutencao.descricaoProblema || 'Não informado.' %>
      </p>
    </section>

    <section class="print-section">
      <h2>Peças previstas no orçamento</h2>
      <% if (componentesExibidos.length) { %>
        <table class="print-table">
          <thead>
            <tr>
              <th>Peça</th>
              <th>Qtd.</th>
              <th>Unitário</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% componentesExibidos.forEach(function(uso) { %>
              <% const componente=uso.componente || {}; %>
                <% const unitario=Number(uso.valorUnitario ?? componente.precoUnitario ?? 0); %>
                  <tr>
                    <td>
                      <%= uso.descricao || componente.nome || 'Peça orçada' %>
                    </td>
                    <td>
                      <%= Number(uso.quantidade || 1) %>
                    </td>
                    <td>R$ <%= unitario.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        %>
                    </td>
                    <td>R$ <%= (unitario * Number(uso.quantidade || 1)).toLocaleString('pt-BR', { minimumFractionDigits:
                        2, maximumFractionDigits: 2 }) %>
                    </td>
                  </tr>
                  <% }) %>
          </tbody>
        </table>
        <% } else { %>
          <p>Nenhum componente informado.</p>
          <% } %>
    </section>

    <div class="print-grid print-grid-bottom">
      <div><span>Entrada</span><strong>
          <%= manutencao.dataEntrada ? new Date(manutencao.dataEntrada).toLocaleDateString('pt-BR') : '-' %>
        </strong></div>
      <div><span>Saída</span><strong>
          <%= manutencao.dataSaida ? new Date(manutencao.dataSaida).toLocaleDateString('pt-BR') : '-' %>
        </strong></div>
      <div><span>Valor total</span><strong>R$ <%= Number(manutencao.valorTotal || 0).toLocaleString('pt-BR', {
            minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></div>
    </div>

    <div class="print-signatures">
      <div><span>Assistência técnica</span></div>
      <div><span>Cliente / responsável</span></div>
    </div>
  </section>

  <script>
    document.querySelector('[data-copy-quote-link]')?.addEventListener('click', async function () {
      const input = document.getElementById('approvalUrl');
      try {
        await navigator.clipboard.writeText(input.value);
        this.textContent = 'Copiado';
      } catch {
        input.select();
        document.execCommand('copy');
        this.textContent = 'Copiado';
      }
    });

    document.querySelectorAll('[data-print-os]').forEach(function (button) {
      button.addEventListener('click', function () {
        document.body.dataset.printMode = button.dataset.printOs;
        window.print();
      });
    });

    window.addEventListener('afterprint', function () {
      delete document.body.dataset.printMode;
    });
  </script>

  <%- include('../partials/footer') %>