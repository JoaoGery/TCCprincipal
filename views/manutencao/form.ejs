<%- include('../partials/header', { title: (manutencao._id ? 'Editar OS' : 'Nova OS' ) + ' | AssistTech' }) %>

  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 page-heading">
      <div>
        <div class="page-eyebrow">Ordem de serviço</div>
        <h1 class="page-title">
          <%= manutencao._id ? 'Editar ordem de serviço' : 'Nova ordem de serviço' %>
        </h1>
        <p class="page-subtitle">Registre o equipamento, problema relatado, diagnóstico e componentes envolvidos.</p>
      </div>
      <div class="d-flex gap-2 align-items-start page-actions">
        <a href="/manutencoes" class="btn btn-outline-secondary">Voltar</a>
      </div>
    </div>

    <div class="content-card form-card">
      <% if (error) { %>
        <div class="alert alert-danger">
          <%= error %>
        </div>
        <% } %>

          <form method="POST"
            action="<%= manutencao._id ? '/manutencoes/' + manutencao._id + '/atualizar' : '/manutencoes' %>"
            class="row g-3">
            <div class="col-12 os-form-section">
              <h2>1. Dados do atendimento</h2>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label" for="cliente">Cliente</label>
                  <select id="cliente" class="form-select" name="cliente" required>
                    <option value="">Selecione um cliente</option>
                    <% clientes.forEach(function(cliente){ %>
                      <option value="<%= cliente._id %>" <%=String(manutencao.cliente)===String(cliente._id)
                        ? 'selected' : '' %>><%= cliente.nome %>
                      </option>
                      <% }) %>
                  </select>
                </div>

                <div class="col-md-3">
                  <label class="form-label" for="marcaComputador">Marca</label>
                  <input id="marcaComputador" type="text" class="form-control" name="marcaComputador"
                    value="<%= manutencao.marcaComputador || '' %>" required>
                </div>

                <div class="col-md-3">
                  <label class="form-label" for="modeloComputador">Modelo</label>
                  <input id="modeloComputador" type="text" class="form-control" name="modeloComputador"
                    value="<%= manutencao.modeloComputador || '' %>" required>
                </div>

                <div class="col-12">
                  <label class="form-label" for="descricaoProblema">Descrição do problema</label>
                  <textarea id="descricaoProblema" class="form-control" rows="4" name="descricaoProblema"
                    required><%= manutencao.descricaoProblema || '' %></textarea>
                </div>

              </div>
            </div>

            <div class="col-12 os-form-section">
              <h2>2. Peças previstas no orçamento</h2>
              <% const quoteItems=manutencao.itensOrcamento || []; const quoteSource=quoteItems.length ? quoteItems :
                (manutencao.componentesUsados || []); const selecionados=quoteItems.length ?
                quoteItems.map(function(item) { return String(item.componente?._id || item.componente); }) :
                (manutencao.componentes || []).map(function(id) { return String(id._id || id); }); const
                quantidadesUsadas={}; const precosOrcamento={}; const descricoesOrcamento={};
                quoteSource.forEach(function(item) { const itemId=String(item.componente?._id || item.componente);
                quantidadesUsadas[itemId]=Number(item.quantidade || 1); if (item.valorUnitario !==undefined)
                precosOrcamento[itemId]=Number(item.valorUnitario || 0); if (item.descricao)
                descricoesOrcamento[itemId]=item.descricao; }); %>
                <div class="component-check-grid">
                  <% componentes.forEach(function(componente){ %>
                    <% const componenteId=String(componente._id); %>
                      <% const selecionado=selecionados.includes(componenteId); %>
                        <% const quantidadeEstoque=Number(componente.quantidadeDisponivel || 0); %>
                          <% const semEstoque=quantidadeEstoque <=0; %>
                            <% const quantidadeUsada=quantidadesUsadas[componenteId] || 1; %>
                              <% const precoOrcado=precosOrcamento[componenteId] ?? Number(componente.precoUnitario ||
                                0); %>
                                <% const descricaoOrcada=descricoesOrcamento[componenteId] || componente.nome; %>
                                  <div class="component-check <%= selecionado ? 'is-selected' : '' %>">
                                    <input type="hidden" name="preco-<%= componenteId %>" value="<%= precoOrcado %>">
                                    <input type="hidden" name="descricaoComponente-<%= componenteId %>"
                                      value="<%= descricaoOrcada %>">
                                    <label class="component-check-select">
                                      <input type="checkbox" name="componentes" value="<%= componente._id %>"
                                        <%=selecionado ? 'checked' : '' %>>
                                      <span>
                                        <strong>
                                          <%= descricaoOrcada %>
                                        </strong>
                                        <small>
                                          <%= componente.categoria || 'Sem categoria' %> · R$ <%=
                                              Number(precoOrcado).toFixed(2) %> / un.
                                        </small>
                                      </span>
                                    </label>
                                    <div class="component-quantity">
                                      <label for="quantidade-<%= componenteId %>">Quantidade orçada</label>
                                      <input id="quantidade-<%= componenteId %>" type="number" min="1"
                                        name="quantidade-<%= componenteId %>"
                                        value="<%= selecionado ? quantidadeUsada : 1 %>"
                                        class="form-control form-control-sm component-quantity-input"
                                        aria-label="Quantidade orçada de <%= componente.nome %>"
                                        data-unit-price="<%= Number(precoOrcado) %>">
                                    </div>
                                    <span
                                      class="status-badge <%= quantidadeEstoque <= 5 ? (quantidadeEstoque > 0 ? 'stock-low' : 'stock-out') : 'stock-ok' %>">
                                      <%= quantidadeEstoque %> un.
                                    </span>
                                  </div>
                                  <% }) %>
                                    <% if (!componentes || componentes.length===0) { %>
                                      <p class="text-secondary mb-0">Nenhum componente cadastrado no estoque.</p>
                                      <% } %>
                </div>
            </div>

            <div class="col-12 os-form-section">
              <h2>3. Mão de obra e total</h2>
              <div class="row g-3 align-items-end">
                <div class="col-md-5">
                  <label class="form-label" for="valorMaoDeObra">Valor da mão de obra (R$)</label>
                  <input id="valorMaoDeObra" type="number" step="0.01" min="0" class="form-control"
                    name="valorMaoDeObra" value="<%= Number(manutencao.valorMaoDeObra || 0).toFixed(2) %>">
                </div>
                <div class="col-md-7">
                  <div class="quote-total-preview">
                    <span>Total estimado do orçamento</span>
                    <strong id="quoteTotalPreview">R$ <%= Number(manutencao.valorTotal || 0).toFixed(2) %></strong>
                  </div>
                </div>
              </div>
            </div>

            <% if (manutencao._id) { %>
              <div class="col-12 os-form-section">
                <h2>4. Acompanhamento da OS</h2>
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label" for="status">Status</label>
                    <select id="status" class="form-select" name="status">
                      <option value="em_analise" <%=manutencao.status==='em_analise' ? 'selected' : '' %>>Em análise
                      </option>
                      <option value="aguardando_aprovacao" <%=manutencao.status==='aguardando_aprovacao' ? 'selected'
                        : '' %>>Aguardando aprovação</option>
                      <option value="orcamento_aprovado" <%=manutencao.status==='orcamento_aprovado' ? 'selected' : ''
                        %>>Orçamento aprovado</option>
                      <option value="orcamento_recusado" <%=manutencao.status==='orcamento_recusado' ? 'selected' : ''
                        %>>Orçamento recusado</option>
                      <option value="em_reparo" <%=manutencao.status==='em_reparo' ? 'selected' : '' %>>Em reparo
                      </option>
                      <option value="concluido" <%=manutencao.status==='concluido' ? 'selected' : '' %>>Concluído
                      </option>
                    </select>
                  </div>

                  <div class="col-12">
                    <label class="form-label" for="diagnosticoTecnico">Diagnóstico técnico</label>
                    <textarea id="diagnosticoTecnico" class="form-control" rows="4"
                      name="diagnosticoTecnico"><%= manutencao.diagnosticoTecnico || '' %></textarea>
                  </div>

                  <div class="col-12">
                    <label class="form-label" for="observacoes">Observações</label>
                    <textarea id="observacoes" class="form-control" rows="3"
                      name="observacoes"><%= manutencao.observacoes || '' %></textarea>
                  </div>
                </div>
              </div>
              <% } %>

                <% if (!manutencao._id) { %>
                  <div class="col-12">
                    <label class="form-check maintenance-notify-option" for="prepararEnvio">
                      <input class="form-check-input" type="checkbox" id="prepararEnvio" name="prepararEnvio">
                      <span>
                        <strong>Quero enviar uma atualização ao cliente</strong>
                        <span class="form-text d-block">Após salvar, você poderá abrir uma mensagem preenchida no
                          WhatsApp ou Gmail e revisar antes de enviar.</span>
                      </span>
                    </label>
                  </div>
                  <% } %>

                    <div class="col-12 form-actions">
                      <a href="/manutencoes" class="btn btn-outline-secondary">Cancelar</a>
                      <button type="submit" class="btn btn-primary">
                        <%= manutencao._id ? 'Salvar alterações' : 'Abrir OS' %>
                      </button>
                    </div>
          </form>
    </div>
  </div>

  <script>
    const updateQuoteTotal = function () {
      const partsTotal = Array.from(document.querySelectorAll('.component-check'))
        .reduce(function (total, card) {
          const checkbox = card.querySelector('input[type="checkbox"]');
          const quantity = card.querySelector('.component-quantity-input');
          if (!checkbox?.checked || !quantity) return total;
          return total + (Number(quantity.value) || 0) * (Number(quantity.dataset.unitPrice) || 0);
        }, 0);
      const labor = Number(document.getElementById('valorMaoDeObra')?.value) || 0;
      const total = partsTotal + labor;
      const output = document.getElementById('quoteTotalPreview');
      if (output) output.textContent = `R$ ${total.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    };

    document.querySelectorAll('.component-check').forEach(function (card) {
      const checkbox = card.querySelector('input[type="checkbox"]');
      const quantity = card.querySelector('input[type="number"]');

      if (!checkbox || !quantity) return;

      checkbox.addEventListener('change', function () {
        quantity.disabled = !checkbox.checked;
        card.classList.toggle('is-selected', checkbox.checked);
        updateQuoteTotal();
        if (checkbox.checked) quantity.focus();
      });

      quantity.addEventListener('input', updateQuoteTotal);
    });

    document.getElementById('valorMaoDeObra')?.addEventListener('input', updateQuoteTotal);
    updateQuoteTotal();
  </script>

  <%- include('../partials/footer') %>